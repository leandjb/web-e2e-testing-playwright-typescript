# ─────────────────────────────────────────────────────────────
# Environment configuration for the E2E suite (Docker + CI).
# Copy this file to `.env` and fill in real values. `.env` is
# gitignored and MUST NEVER be committed. In CI these values are
# supplied as GitHub Secrets / Variables instead.
# ─────────────────────────────────────────────────────────────

# Base URL of the application under test.
BASE_URL=https://www.saucedemo.com

# Shared password for the SauceDemo users (the demo site uses one
# password for every account). In CI set this as a GitHub Secret.
SAUCEDEMO_PASSWORD=secret_sauce

# Username for the standard, fully-working account.
SAUCEDEMO_USER_STANDARD=standard_user

# Username for the account that is intentionally locked out.
SAUCEDEMO_USER_LOCKED=locked_out_user

# The following accounts exist on SauceDemo but are NOT exercised by
# the current (stage-1) suite. They are listed here so the CI matrix
# and credentials plumbing are ready when the suite is expanded.
SAUCEDEMO_USER_PROBLEM=problem_user
SAUCEDEMO_USER_PERFORMANCE=performance_glitch_user
SAUCEDEMO_USER_ERROR=error_user
SAUCEDEMO_USER_VISUAL=visual_user

# Number of shards to run locally (CI always uses 2 via the matrix).
TOTAL_SHARDS=2

# Runtime mode selected by run-e2e.sh: "smoke" or "full".
TEST_MODE=full
